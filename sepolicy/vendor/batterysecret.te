type batterysecret, domain;
type batterysecret_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(batterysecret)

allow batterysecret kmsg_device:chr_file rw_file_perms;
allow batterysecret self:capability { chown fsetid sys_tty_config sys_boot };
allow batterysecret self:capability2 { block_suspend };
allow batterysecret self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

allow batterysecret sysfs:file write;
allow batterysecret sysfs_usb:file rw_file_perms;
allow batterysecret sysfs_batteryinfo:dir r_dir_perms;
allow batterysecret sysfs_batteryinfo:file rw_file_perms;
allow batterysecret sysfs_type:dir r_dir_perms;
allow batterysecret sysfs_type:file r_file_perms;
allow batterysecret sysfs_type:lnk_file r_file_perms;
allow batterysecret sysfs_wake_lock:file rw_file_perms;

allow batterysecret rootfs:dir r_dir_perms;
allow batterysecret rootfs:file r_file_perms;
allow batterysecret rootfs:lnk_file r_file_perms;

allow batterysecret cgroup:dir r_dir_perms;
allow batterysecret cgroup:file r_file_perms;
allow batterysecret cgroup:lnk_file r_file_perms;

allow batterysecret mnt_vendor_file:dir create_dir_perms;

# Binder and wakelock
binder_use(batterysecret)
wakelock_use(batterysecret)
